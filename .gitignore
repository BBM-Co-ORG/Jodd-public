.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust / Tauri build outputs
# Workspace conversion (Task 12) moved the build dir from src-tauri/target/ to
# the workspace root's /target — cargo build/run from repo root land here now.
/target
src-tauri/target/
src-tauri/gen/schemas/

# IDE
.vscode/
.qoder/

# OS
**/.DS_Store

# Bundles
/dist
.claude/

# Generated from CHANGELOG.md at build time (do not commit)
src/lib/generated/

# Subagent-driven-development scratch: ledgers, briefs, reports, review packages.
# Session-local working state, not project content.
.superpowers/

# graphify knowledge graph — derived from the repo, rebuilt by the post-commit
# hook on every commit. Several MB of generated HTML/JSON; regenerate with
# /graphify rather than committing it.
graphify-out/

# Android signing keystore — never committed. Tauri ignores
# key.properties/keystore.properties inside gen/android already, but the
# keystore itself lives at the repo root.
*.keystore
*.jks

# Python bytecode from the dev probe scripts in scripts/
__pycache__/

# thClaws' per-project directory, created the moment `thclaws` runs with this
# repo as its working directory — it lands here from an ordinary Extract, since
# the thclaws LLM preset spawns the CLI (gotcha #7). Holds that developer's own
# settings.json and session `state`, so it is per-machine, not project content.
#
# Note this ignores the WHOLE directory. thClaws also uses `.thclaws/` for
# things a team might genuinely want to share (skills, MCP servers, plugins,
# AGENTS.md). If Jodd ever ships such a config, un-ignore those paths
# specifically rather than deleting this rule — the session state must stay out
# either way.
.thclaws/
